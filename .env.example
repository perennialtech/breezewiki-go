# Generated by make generate-config-examples; do not edit.
# For docker run --env-file; nested settings use :: in their names.
# Name displayed in page footers and startup logs.
BW_APPLICATION_NAME=BreezeWiki
# Listening address. auto binds all interfaces, or loopback when debug is true.
BW_BIND_HOST=auto
# TCP port for the HTTP server (1-65535).
BW_PORT=10416
# Public URL for canonical links and subdomain redirects. Empty disables those features; POST origin checks then use the request host.
BW_CANONICAL_ORIGIN=
# Disable static asset caching and bind loopback when bind_host is auto.
BW_DEBUG=false
# Enable the client-side Fandom search suggestion widget.
BW_FEATURE_SEARCH_SUGGESTIONS=true
# Show the original BreezeWiki developer attribution as the instance operator.
BW_INSTANCE_IS_OFFICIAL=false
# Log outgoing Fandom API requests.
BW_LOG_OUTGOING=true
# Route supported external image, stylesheet, and icon URLs through the local /proxy endpoint.
BW_STRICT_PROXY=false
# Load wiki data in the browser instead of rendering it server-side on GET.
BW_FEATURE_JSONP::ENABLED=true
# Log incoming HTTP requests.
BW_ACCESS_LOG::ENABLED=false
